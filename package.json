{
  "name": "selfdef",
  "displayName": "selfDef",
  "description": "make goto link write in your project,and easy to jump to the file",
  "version": "0.1.4",
  "icon": "images/easyGotoLogo.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "publisher": "selfdef",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nick357/easyGoto.git"
  },
  "activationEvents": [
    "workspaceContains:**/*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "selfdef.copyLink",
        "title": "copy @ link"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "selfdef.copyLink",
          "group": "group1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "eslint": "^8.34.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5",
    "@vscode/test-electron": "^2.2.3"
  }
}
